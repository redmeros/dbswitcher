<Window x:Class="DBSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DBSwitcher"
        mc:Ignorable="d"
        Title="ASDbSwitcher" Height="560" Width="860" MinWidth="480" MinHeight="300">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="zStackPanel" Margin="6"/>
        </ScrollViewer>

        <Button x:Name="FabButton" Style="{StaticResource FabButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,24,0"
                ToolTip="Otwórz katalog ustawień" Click="OpenConfigDirMenuItemClick">
            <Grid Width="26" Height="24">
                <Path Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round" Width="22" Height="18"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                      Data="M1,3 Q1,1 3,1 L8,1 L10.5,4 L21,4 Q23,4 23,6 L23,17 Q23,19 21,19 L3,19 Q1,19 1,17 Z"/>
                <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Grid Width="12" Height="12">
                        <Ellipse Width="9" Height="9" Stroke="White" StrokeThickness="3"
                                 StrokeDashArray="0.65,0.65"/>
                        <Ellipse Width="7" Height="7" Stroke="White" StrokeThickness="2"/>
                    </Grid>
                </Border>
            </Grid>
        </Button>
    </Grid>
</Window>
